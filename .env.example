# AntCode 环境配置文件示例
# 复制此文件为 .env 并根据需要修改

# ============ 共享基础设施（web_api / master / gateway / worker） ============
# 必须使用 PostgreSQL。业务数据、日志、source bundle、产物 blob 全部写入 PostgreSQL。
DATABASE_URL=postgresql://user:password@localhost:5432/antcode

# PostgreSQL TLS 通过 DATABASE_URL 显式配置。verify-ca / verify-full 必须同时
# 指定 sslrootcert；证书路径是应用进程（容器内）可读路径。
# DATABASE_URL=postgresql://user:password@db:5432/antcode?sslmode=verify-full&sslrootcert=/etc/antcode/tls/postgres-ca.crt

# 数据库连接池（每服务独立 maxsize；总和应 < PG max_connections / 2）
# DB_POOL_MIN=2
# DB_POOL_MAX=10              # 兜底默认，未识别 service 时使用
# DB_POOL_MAX_WEB_API=20
# DB_POOL_MAX_MASTER=15
# DB_POOL_MAX_GATEWAY=10
# DB_POOL_MAX_WORKER=5

# 格式: redis://[:password]@host:port/db
# 支持三种部署形态（通过 URL scheme 或 REDIS_MODE 分派）：
#   redis://host:port          — standalone（默认）
#   rediss://host:port         — standalone + TLS
#   redis+cluster://n1:port    — Redis Cluster（客户端从此节点发现全拓扑）
#   redis+sentinel://mymaster@s1:26379,s2:26379[/db]  — Sentinel
#   rediss+sentinel://mymaster@s1:26379,s2:26379/db?... — Sentinel + TLS
# 详见 docs/redis-cluster.md
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=antcode

# 显式覆盖模式（可选，通常 URL scheme 已够用）
# REDIS_MODE=standalone|cluster|sentinel
# REDIS_SENTINEL_MASTER_NAME=mymaster
# Sentinel 与 master ACL 凭据必须分开配置，私有 CA 路径需 URL 编码：
# REDIS_URL=rediss+sentinel://mymaster@s1:26379,s2:26379/0?sentinel_username=sentinel-user&sentinel_password=...&master_username=app-user&master_password=...&ssl_ca_certs=%2Frun%2Fsecrets%2Fredis-ca.pem

# Direct Worker 独立 Redis ACL（防 worker 间横向移动；Redis 6+ 必备）
# REDIS_ACL_ENABLED=true            # 默认 true；Direct Worker 禁止关闭
# REDIS_ACL_SAVE_INTERVAL_SECONDS=300  # ACL SAVE 周期（防 Redis 重启丢运行时 ACL）

# 共享日志输出
LOG_LEVEL=INFO
SSE_MAX_CONN_PER_EXECUTION=100
SSE_MAX_TOTAL_CONN=1000
SSE_MAX_CONN_PER_USER=10
SSE_HISTORY_MAX_BYTES=8388608
SSE_QUEUE_MAX_MESSAGES=1000
SSE_QUEUE_MAX_BYTES=2097152
SSE_LEASE_TTL_SECONDS=60

# ============ 必填密钥（缺失即启动失败） ============
# ENCRYPTION_KEY: 用于 Fernet 加密 git credentials / worker api_key / redis password 等
#   至少 32 字节（不足则拒绝启动）；44 字符 Fernet 原生 key 可直接使用（此时无需 SALT）。
#   生产：`python -c "import secrets;print(secrets.token_urlsafe(48))"`
ENCRYPTION_KEY=
# 非 Fernet 原生 key 必须配置每部署唯一的随机 salt，例如：openssl rand -hex 16
ENCRYPTION_KEY_SALT=
# 从旧固定 salt 版本迁移时临时设置为 antcode-fernet-v1，完成 rotate 后清空
ENCRYPTION_LEGACY_KDF_SALT=

# JWT_SECRET（或 JWT_SECRET_FILE 指向文件）：用于签发/校验 access token
#   至少 32 字节（不足则拒绝启动）。二选一：
#   JWT_SECRET=<inline>
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET=
# JWT_SECRET_FILE=

# 密钥轮换：把旧 ENCRYPTION_KEY 放到 legacy 列表（逗号分隔），加密始终用当前
# ENCRYPTION_KEY，解密依次尝试所有。清空 legacy 前必须执行
# scripts/rotate_encryption_key.py 的 dry-run、显式 apply 和 --verify-primary-only；
# Worker 专用命令只覆盖 Worker HMAC/Redis ACL，不能作为全域撤销依据。
# ENCRYPTION_KEYS_LEGACY=old-key-1,old-key-2
# 仅迁移旧 SHA256 派生密文时临时开启；完成 rotate 后立即关闭
ENCRYPTION_ALLOW_LEGACY_SHA256=false

# 注意：改 ENCRYPTION_KEY_SALT 等同换密钥 —— 旧密文将解不开，需按上面的轮换流程重加密。

# ============ Web API（antcode_web_api） ============
# BIND_HOST 是后端监听地址；SERVER_PORT 是后端 API 端口。
BIND_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DOMAIN=localhost

# 逗号分隔的受信反向代理 IP/CIDR。仅填写与 Web API 直接建立连接的实际
# Nginx/Ingress 代理地址；留空时忽略 X-Forwarded-For/X-Real-IP。
# 禁止使用 0.0.0.0/0、::/0 或客户端网段，否则外部请求可伪造来源 IP。
ANTCODE_TRUSTED_PROXIES=

# uvicorn worker 进程数（IO-bound，默认 2）。
# 单机跑多服务或 K8s 2 vCPU pod 直接用默认；需要更高吞吐或独占多核时上调，
# 参考实测 workers=4 时 RPS ~3x、MEM ~4x（每 worker ~155MB）。
# 生产扩容优先水平加 replica，别无脑加 workers（每 worker 独立 DB 池，
# 撞 max_connections 更快）—— 保证 DB_POOL_MAX_WEB_API * SERVER_WORKERS
# < PostgreSQL max_connections / 2。>1 时自动禁用 --reload。
# SERVER_WORKERS=2

# FRONTEND_PORT 是前端开发服务端口，不和 SERVER_PORT 共用。
FRONTEND_PORT=3000

# 可选：只有对外访问地址无法由 SERVER_DOMAIN + SERVER_PORT 推导时才需要。
# API_BASE_URL=http://localhost:8000
# Worker 控制面默认仅允许 HTTPS（loopback HTTP 除外）。仅 Docker 内部单标签
# 服务名可显式开启；不得用于 IP、FQDN 或跨主机网络。
WORKER_API_ALLOW_INSECURE_INTERNAL=false

# Worker 一键安装源码分发。SOURCE_REF 必须固定到完整的 40 位 Git commit，
# 不能使用 main、tag 或其他可变引用；远程 API_BASE_URL 必须使用 HTTPS。
# WORKER_INSTALL_SOURCE_URL=https://github.com/xyuns-cc/AntCode.git
# WORKER_INSTALL_SOURCE_REF=0123456789abcdef0123456789abcdef01234567
# WORKER_INSTALL_GATEWAY_TLS=true
# WORKER_INSTALL_UV_VERSION=0.8.17

# 默认管理员账号（首次启动时自动创建，必须配置密码才会创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# CORS 白名单由 SERVER_DOMAIN + FRONTEND_PORT 自动推导（config.py 的 CORS_ORIGINS：
# http://{SERVER_DOMAIN}:{FRONTEND_PORT} + localhost/127.0.0.1 同端口；非本地域名再加
# https://{SERVER_DOMAIN}）。不存在 CORS_ALLOWED_ORIGINS 之类的手工列表变量。

# 登录密码是否强制加密传输（生产建议 true；开发/内部可关闭方便调试）
# LOGIN_PASSWORD_ENCRYPTION_ENABLED=true
# LOGIN_PASSWORD_ENCRYPTION_REQUIRED=true

# 登录限流 + 账户锁定（web_api/routes/v1/base.py 生效）
# LOGIN_RATE_LIMIT_IP_MAX=5             # 每 IP 每分钟最多尝试
# LOGIN_RATE_LIMIT_IP_PERIOD=60
# LOGIN_RATE_LIMIT_USER_MAX=10          # 每用户名每 15 分钟最多尝试
# LOGIN_RATE_LIMIT_USER_PERIOD=900
# LOGIN_LOCKOUT_FAILURES=5              # 连续失败 N 次触发锁定
# LOGIN_LOCKOUT_DURATION_SEC=900        # 锁定持续秒数

# 全局限流（RateLimitMiddleware，per client IP，Redis 滑动窗口）
# RATE_LIMIT_CALLS=1000                 # 窗口内最大请求数（默认 1000）
# RATE_LIMIT_PERIOD=60                  # 窗口秒数

# 数据保留策略（log_cleanup_service 24h 跑一次批式 DELETE）
# TASK_LOG_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=90
# WORKER_EVENT_RETENTION_DAYS=30
# WORKER_HEARTBEAT_RETENTION_DAYS=30
# SCHEDULER_OUTBOX_RETENTION_DAYS=30
# LOG_CLEANUP_BATCH_LIMIT=5000          # 单次 DELETE 上限，防长事务

# 派发失败自动补派（master.redispatch_loop）
# REDISPATCH_MAX_ATTEMPTS=5
# REDISPATCH_BASE_DELAY_SEC=30
# REDISPATCH_MAX_DELAY_SEC=300
# REDISPATCH_TICK_INTERVAL_SEC=10

# 是否允许连接私有网络节点（仅限内网部署时设为 true）
ALLOW_PRIVATE_NODES=false

# 规则项目连接探测：绝对总超时和响应体硬上限
PROJECT_TEST_CONNECTION_TIMEOUT_SECONDS=5
PROJECT_TEST_CONNECTION_MAX_RESPONSE_BYTES=1048576

# Git 扫描/source bundle 下载边界
GIT_DNS_TIMEOUT_SECONDS=10
GIT_LS_REMOTE_TIMEOUT_SECONDS=30
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_MAX_COMMAND_OUTPUT_BYTES=8388608
GIT_MAX_TRANSFER_BYTES=536870912
GIT_MAX_REPOSITORY_BYTES=536870912
GIT_MAX_BLOB_BYTES=67108864
GIT_MAX_OBJECTS=200000
GIT_MAX_REFS=20000
GIT_SCAN_MAX_FILES=100000
GIT_SCAN_MAX_DIRECTORIES=20000
GIT_SCAN_MAX_DEPTH=50
GIT_SCAN_MAX_CANDIDATES=10000

# 管理批量接口和 Worker Node 依赖安装边界
API_MANAGEMENT_BATCH_MAX_ITEMS=100
NODE_PACKAGE_REGISTRY_ALLOWLIST=https://registry.npmjs.org
NODE_LOCKFILE_MAX_BYTES=8388608
NODE_INSTALL_MAX_OUTPUT_BYTES=2097152

# 是否验证告警 Webhook 的 SSL 证书（生产环境建议 true；SMTP TLS 始终验证）
ALERT_VERIFY_SSL=true

# ============ 控制面 Worker 接入策略（web_api / master） ============
# Worker 通过 transport.mode 明确选择接入方式：
# - direct: 内网直连 Redis Streams（低延迟高吞吐）
# - gateway: 公网仅连 gRPC 网关（Redis/PostgreSQL 不暴露公网）
WORKER_TRANSPORT_MODE=gateway

# Worker 在线状态判定（控制面读取）
# WORKER_HEARTBEAT_TIMEOUT=60
# WORKER_HEARTBEAT_INTERVAL_ONLINE=3
# WORKER_HEARTBEAT_INTERVAL_OFFLINE=60

# Web API 下发给 Worker 的网关地址
GATEWAY_HOST=localhost
GATEWAY_PORT=50051

# ============ Gateway 服务（antcode_gateway） ============
# 是否启用 gRPC 服务（Worker <-> Gateway）
GRPC_ENABLED=true
# Gateway 实际监听地址，未配置时默认 0.0.0.0
# GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=10
GRPC_HEARTBEAT_INTERVAL=30
GRPC_HEARTBEAT_TIMEOUT=90
GRPC_SHUTDOWN_GRACE_PERIOD=5.0
GRPC_TLS_CERT_PATH=
GRPC_TLS_KEY_PATH=
GRPC_TLS_CA_PATH=
AUTH_ENABLED=true
# mTLS 无独立开关：同时配置 GRPC_TLS_CERT_PATH / GRPC_TLS_KEY_PATH / GRPC_TLS_CA_PATH
# 三项即启用双向 TLS（配了 CA 就校验客户端证书，CN/SAN 须匹配 worker_id）
# AUTH_ENABLED=true + 无 TLS 证书时网关默认拒绝启动（凭证会明文传输）。
# 仅本地/内网测试可显式放行；生产严禁开启。
# ANTCODE_GATEWAY_ALLOW_INSECURE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=100
RATE_LIMIT_CAPACITY=200
# StreamLogs 业务层容量限制（按 protobuf / UTF-8 实际字节）
# GATEWAY_LOG_MAX_BATCH_BYTES=8388608
# GATEWAY_LOG_MAX_ENTRY_CONTENT_BYTES=262144

# ============ Worker（antcode_worker） ============
# 默认 persistent：优先读取 data/worker/secrets/worker_credentials.json（0600），
# 文件不存在时才读取 WORKER_CREDENTIAL_* 环境变量；容器可显式改为 env。
# WORKER_CREDENTIAL_STORE=persistent
WORKER_ID=worker-001
ANTCODE_WORKER_KEY=
# V2 安装 Key 注册成功响应丢失后的幂等恢复窗口（秒，1..86400）
WORKER_REGISTRATION_RECOVERY_SECONDS=3600

# Worker 启动时只检测 mise（多语言运行时管理器），不会下载或执行远程脚本。
# 容器化部署走镜像内置（Dockerfile.worker 已预装）；
# Worker 运行期不会自动下载 mise；裸机请使用发行版包或经版本与摘要校验的制品安装。
# Windows 一律手动：`winget install jdx.mise`。

# 允许 HTTP 协议的 git 凭证/仓库地址（dev/内网 Gitea/Gogs 场景专用）
# 生产严禁开启：凭证会明文推上网络。默认关，dev 显式声明再开。
ANTCODE_GIT_ALLOW_HTTP=false

# SpiderData 完整结果默认无限保留；只有管理员显式配置正数才启用 retention。
# 0 = 不裁剪/不自动过期；负数或非整数会使对应服务启动/任务显式失败。
# Worker Direct transport + legacy Scrapy Redis sink：
ANTCODE_SPIDER_STREAM_MAXLEN=0
ANTCODE_SPIDER_META_TTL_SECONDS=0
# Gateway SpiderData handler（stream/meta/index 使用相同 TTL）：
SPIDER_STREAM_MAXLEN=0
SPIDER_META_TTL_SECONDS=0
# ANTCODE_SPIDER_XADD_FAIL_THRESHOLD=20  # 连续 xadd 失败超阈值 → CloseSpider
# ANTCODE_SPIDER_HEARTBEAT_INTERVAL=50   # 每 N 条 item 刷 items_count 心跳

# Worker 能力开关（可关掉部分 plugin 做 code-only / spider-only 部署）
# WORKER_ENABLE_RULE_PLUGIN=true

# Executor 沙箱（P0-a5）：默认 sandbox 模式 + bwrap（bubblewrap），
# Dockerfile.worker 已预装；裸机部署需自行安装 bubblewrap 或改用 firejail。
# sandbox_mode=sandbox 时 WORKER_SANDBOX_COMMAND 必填（缺失即拒绝启动）。
# WORKER_SANDBOX_MODE=sandbox
# WORKER_SANDBOX_COMMAND=bwrap
# WORKER_SANDBOX_NETWORK_ISOLATED=true

# Executor 沙箱硬限制（POSIX rlimit；非 POSIX 平台自动跳过）
# 暂不支持环境变量，请在 data/worker/worker_config.yaml 中配置：
#   sandbox_enforce_rlimit: true
#   sandbox_max_open_files: 2048   # RLIMIT_NOFILE
#   sandbox_max_processes: 64      # RLIMIT_NPROC（防 fork 炸弹）

# Rule 出站代理的单任务硬预算（Worker 父进程执行，不受 payload rlimit 替代）。
# 连接数还会受任务进程上限约束，时长还会受任务 timeout 约束；流量为所有 HTTP/CONNECT
# 连接的双向累计字节。任一预算耗尽都会断开连接并将任务显式结算为失败。
WORKER_RULE_EGRESS_MAX_CONNECTIONS=32
WORKER_RULE_EGRESS_MAX_BYTES=1073741824
WORKER_RULE_EGRESS_MAX_DURATION_SECONDS=3600

# Worker 本地运行参数（按需覆盖）
# WORKER_NAME=prod-worker-01
# WORKER_HOST=192.168.1.10
# WORKER_PORT=8001
# WORKER_REGION=local
# WORKER_HEARTBEAT_INTERVAL=30

# ---------- Direct 模式配置（内网） ----------
# 仅用于可信内网、单租户测试；生产禁止使用 Direct。
# 仅当 WORKER_TRANSPORT_MODE=direct 时生效
# WORKER_REDIS_URL=redis://10.0.0.10:6379/0
# WORKER_REDIS_NAMESPACE=antcode
# WORKER_CONSUMER_GROUP=antcode-workers

# ---------- Gateway 模式配置（公网） ----------
# 生产 Worker 应使用独立环境文件，不得复用服务端 DATABASE_URL/REDIS_URL：
# DATABASE_URL=
# REDIS_URL=
# WORKER_GATEWAY_BACKENDLESS=true
# Direct Worker 专用：Redis 只用 WORKER_REDIS_URL 最小权限账号（禁止 REDIS_URL），
# 但产物平面直连 PG，DATABASE_URL 仍必需。详见 docs/worker-transport.md。
# WORKER_DIRECT_SCOPED_REDIS=true
# 仅当 WORKER_TRANSPORT_MODE=gateway 时生效
WORKER_GATEWAY_HOST=localhost
WORKER_GATEWAY_PORT=50051
WORKER_GATEWAY_TLS=false
# WORKER_CA_CERT=./data/worker/secrets/ca.crt

# mTLS 客户端证书（可选，与 API Key 二选一）
# WORKER_CLIENT_CERT=./data/worker/secrets/client.crt
# WORKER_CLIENT_KEY=./data/worker/secrets/client.key

# API Key 认证（与 mTLS 二选一）
# WORKER_API_KEY=ak_your_worker_api_key
