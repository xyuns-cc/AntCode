# AntCode 环境配置文件示例
# 复制此文件为 .env 并根据需要修改

# ============ 共享基础设施（web_api / master / gateway / worker） ============
# 必须使用 PostgreSQL。业务数据、日志、source bundle、产物 blob 全部写入 PostgreSQL。
DATABASE_URL=postgresql://user:password@localhost:5432/antcode

# 可选：数据库 SSL
# DB_SSL=1
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem
# DB_SSL_VERIFY=1

# 数据库连接池（每服务独立 maxsize；总和应 < PG max_connections / 2）
# DB_POOL_MIN=2
# DB_POOL_MAX=10              # 兜底默认，未识别 service 时使用
# DB_POOL_MAX_WEB_API=20
# DB_POOL_MAX_MASTER=15
# DB_POOL_MAX_GATEWAY=10
# DB_POOL_MAX_WORKER=5

# 格式: redis://[:password]@host:port/db
# 支持三种部署形态（通过 URL scheme 或 REDIS_MODE 分派）：
#   redis://host:port          — standalone（默认）
#   rediss://host:port         — standalone + TLS
#   redis+cluster://n1:port    — Redis Cluster（客户端从此节点发现全拓扑）
#   redis+sentinel://mymaster@s1:26379,s2:26379[/db]  — Sentinel
# 详见 docs/redis-cluster.md
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=antcode

# 显式覆盖模式（可选，通常 URL scheme 已够用）
# REDIS_MODE=standalone|cluster|sentinel
# REDIS_SENTINEL_MASTER_NAME=mymaster

# Direct Worker 独立 Redis ACL（防 worker 间横向移动；Redis 6+ 必备）
# REDIS_ACL_ENABLED=true            # 默认 true；紧急回滚时设 false 退回共享密码模式
# REDIS_ACL_SAVE_INTERVAL_SECONDS=300  # ACL SAVE 周期（防 Redis 重启丢运行时 ACL）

# 共享日志输出
LOG_LEVEL=INFO

# ============ 必填密钥（缺失即启动失败） ============
# ENCRYPTION_KEY: 用于 Fernet 加密 git credentials / worker api_key / redis password 等
#   任意字符串，>=32 字节推荐。生产：`python -c "import secrets;print(secrets.token_urlsafe(48))"`
ENCRYPTION_KEY=

# JWT_SECRET（或 JWT_SECRET_FILE 指向文件）：用于签发/校验 access token
#   任意字符串，>=32 字节推荐。二选一：
#   JWT_SECRET=<inline>
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_SECRET=
# JWT_SECRET_FILE=

# 密钥轮换：把旧 ENCRYPTION_KEY 放到 legacy 列表（逗号分隔），加密始终用当前
# ENCRYPTION_KEY，解密依次尝试所有。轮换完成一段时间后可清空 legacy。
# ENCRYPTION_KEYS_LEGACY=old-key-1,old-key-2

# ============ Web API（antcode_web_api） ============
# BIND_HOST 是后端监听地址；SERVER_PORT 是后端 API 端口。
BIND_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DOMAIN=localhost

# FRONTEND_PORT 是前端开发服务端口，不和 SERVER_PORT 共用。
FRONTEND_PORT=3000

# 可选：只有对外访问地址无法由 SERVER_DOMAIN + SERVER_PORT 推导时才需要。
# API_BASE_URL=http://localhost:8000

# 默认管理员账号（首次启动时自动创建，必须配置密码才会创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# CORS 允许的来源（逗号分隔，生产环境请设置具体域名）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 登录密码是否强制加密传输（生产建议 true；开发/内部可关闭方便调试）
# LOGIN_PASSWORD_ENCRYPTION_ENABLED=true
# LOGIN_PASSWORD_ENCRYPTION_REQUIRED=true

# 登录限流 + 账户锁定（web_api/routes/v1/base.py 生效）
# LOGIN_RATE_LIMIT_IP_MAX=5             # 每 IP 每分钟最多尝试
# LOGIN_RATE_LIMIT_IP_PERIOD=60
# LOGIN_RATE_LIMIT_USER_MAX=10          # 每用户名每 15 分钟最多尝试
# LOGIN_RATE_LIMIT_USER_PERIOD=900
# LOGIN_LOCKOUT_FAILURES=5              # 连续失败 N 次触发锁定
# LOGIN_LOCKOUT_DURATION_SEC=900        # 锁定持续秒数

# 全局限流（RateLimitMiddleware，per client IP，Redis 滑动窗口）
# RATE_LIMIT_CALLS=100                  # 窗口内最大请求数
# RATE_LIMIT_PERIOD=60                  # 窗口秒数

# 数据保留策略（log_cleanup_service 24h 跑一次批式 DELETE）
# TASK_LOG_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=90
# WORKER_EVENT_RETENTION_DAYS=30
# LOG_CLEANUP_BATCH_LIMIT=5000          # 单次 DELETE 上限，防长事务

# 派发失败自动补派（master.redispatch_loop）
# REDISPATCH_MAX_ATTEMPTS=5
# REDISPATCH_BASE_DELAY_SEC=30
# REDISPATCH_MAX_DELAY_SEC=300
# REDISPATCH_TICK_INTERVAL_SEC=10

# 是否允许连接私有网络节点（仅限内网部署时设为 true）
ALLOW_PRIVATE_NODES=false

# 是否验证告警 Webhook 的 SSL 证书（生产环境建议 true）
ALERT_VERIFY_SSL=true

# ============ 控制面 Worker 接入策略（web_api / master） ============
# Worker 通过 transport.mode 明确选择接入方式：
# - direct: 内网直连 Redis Streams（低延迟高吞吐）
# - gateway: 公网仅连 gRPC 网关（Redis/PostgreSQL 不暴露公网）
WORKER_TRANSPORT_MODE=gateway

# Worker 在线状态判定（控制面读取）
# WORKER_HEARTBEAT_TIMEOUT=60
# WORKER_HEARTBEAT_INTERVAL_ONLINE=3
# WORKER_HEARTBEAT_INTERVAL_OFFLINE=60

# Web API 下发给 Worker 的网关地址
GATEWAY_HOST=localhost
GATEWAY_PORT=50051

# ============ Gateway 服务（antcode_gateway） ============
# 是否启用 gRPC 服务（Worker <-> Gateway）
GRPC_ENABLED=true
# Gateway 实际监听地址，未配置时默认 0.0.0.0
# GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=10
GRPC_HEARTBEAT_INTERVAL=30
GRPC_HEARTBEAT_TIMEOUT=90
GRPC_SHUTDOWN_GRACE_PERIOD=5.0
GRPC_TLS_CERT_PATH=
GRPC_TLS_KEY_PATH=
GRPC_TLS_CA_PATH=
AUTH_ENABLED=true
# 强制 mTLS：所有 gRPC 调用都必须通过 peer 证书（CN/SAN 须匹配 worker_id）
GRPC_REQUIRE_MTLS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=100
RATE_LIMIT_CAPACITY=200

# ============ Worker（antcode_worker） ============
# Worker 凭证存储类型在 worker_config.yaml 的 credential_store 中配置
WORKER_ID=worker-001
ANTCODE_WORKER_KEY=

# Worker 启动时检测 mise（多语言运行时管理器）。缺失时是否 curl|sh 官方脚本？
# 默认 false — 官方 URL 常量安全（不可注入），但 curl|sh 依赖 CDN/网络信任，
# 且离线/内网必败。推荐：容器化部署走镜像内置（Dockerfile.worker 已预装），
# 裸机部署可临时 true 首次安装后再关，或手动 `curl -fsSL https://mise.run | sh`。
# Windows 一律手动：`winget install jdx.mise`。
ANTCODE_MISE_AUTO_INSTALL=false

# 允许 HTTP 协议的 git 凭证/仓库地址（dev/内网 Gitea/Gogs 场景专用）
# 生产严禁开启：凭证会明文推上网络。默认关，dev 显式声明再开。
ANTCODE_GIT_ALLOW_HTTP=false

# Worker 日志缓冲配置
LOG_BUFFER_SIZE=50
LOG_FLUSH_INTERVAL=2.0
LOG_BUFFER_MAX_LINES=500

# 爬虫数据存储配置
SPIDER_DATA_ENABLED=true
SPIDER_DATA_BATCH_SIZE=50
SPIDER_DATA_FLUSH_INTERVAL=5.0
SPIDER_DATA_TTL=86400
SPIDER_DATA_MAX_ITEMS=10000
SPIDER_STREAM_MAX_LEN=10000
# 子进程 spider pipeline（antcode_scrapy.pipelines.redis_pipeline）
# ANTCODE_SPIDER_STREAM_MAXLEN=10000     # spider:data:{run_id} 近似 MAXLEN
# ANTCODE_SPIDER_META_TTL_SECONDS=86400  # spider:meta:{run_id} TTL
# ANTCODE_SPIDER_XADD_FAIL_THRESHOLD=20  # 连续 xadd 失败超阈值 → CloseSpider
# ANTCODE_SPIDER_HEARTBEAT_INTERVAL=50   # 每 N 条 item 刷 items_count 心跳

# Worker 能力开关（可关掉部分 plugin 做 code-only / spider-only 部署）
# WORKER_ENABLE_RULE_PLUGIN=true

# Executor 沙箱硬限制（POSIX rlimit；非 POSIX 平台自动跳过）
# WORKER_SANDBOX_ENFORCE_RLIMIT=true
# WORKER_SANDBOX_MAX_OPEN_FILES=2048
# WORKER_SANDBOX_MAX_PROCESSES=64
# WORKER_SANDBOX_MAX_FILE_SIZE_MB=1024   # T7-P2-4 单文件写入上限（RLIMIT_FSIZE）

# Worker 本地运行参数（按需覆盖）
# WORKER_NAME=prod-worker-01
# WORKER_HOST=192.168.1.10
# WORKER_PORT=8001
# WORKER_REGION=local
# WORKER_HEARTBEAT_INTERVAL=30

# ---------- Direct 模式配置（内网） ----------
# 仅当 WORKER_TRANSPORT_MODE=direct 时生效
# WORKER_REDIS_URL=redis://10.0.0.10:6379/0
# WORKER_REDIS_NAMESPACE=antcode
# WORKER_CONSUMER_GROUP=antcode-workers

# ---------- Gateway 模式配置（公网） ----------
# 仅当 WORKER_TRANSPORT_MODE=gateway 时生效
WORKER_GATEWAY_HOST=localhost
WORKER_GATEWAY_PORT=50051
WORKER_GATEWAY_TLS=false
# WORKER_CA_CERT=./data/worker/secrets/ca.crt

# mTLS 客户端证书（可选，与 API Key 二选一）
# WORKER_CLIENT_CERT=./data/worker/secrets/client.crt
# WORKER_CLIENT_KEY=./data/worker/secrets/client.key

# API Key 认证（与 mTLS 二选一）
# WORKER_API_KEY=ak_your_worker_api_key
