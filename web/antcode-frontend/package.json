{
  "name": "antcode-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "npm run type-check && vite build --mode production",
    "build:analyze": "node ./scripts/generate-bundle-report.mjs",
    "build:staging": "vite build --mode staging",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 50",
    "lint:ci": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "preview": "vite preview --port 3001",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@tanstack/react-query": "^5.66.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "antd": "^5.21.6",
    "axios": "^1.7.7",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "node-forge": "1.4.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "16.1.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.8.1",
    "@types/node-forge": "1.3.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "^15.11.0",
    "jsdom": "26.1.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "5.14.0",
    "terser": "^5.36.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vite-plugin-compression": "0.5.1",
    "vitest": "4.1.10"
  }
}
