# =====================================================
# AntCode Gateway 网关服务 - Data Plane
# =====================================================
# 公网 Worker 接入（gRPC/TLS）、认证、限流、日志收集、结果回写
# =====================================================

# ================== 阶段 1: 构建阶段 ==================
FROM python:3.11.11-slim AS builder

WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖和 uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# 设置 uv 路径
ENV PATH="/root/.local/bin:${PATH}"

# 复制 workspace 配置
COPY pyproject.toml uv.lock ./

# 复制共享包
COPY packages/antcode_core/pyproject.toml packages/antcode_core/
COPY packages/antcode_core/src packages/antcode_core/src/
COPY packages/antcode_contracts/pyproject.toml packages/antcode_contracts/
COPY packages/antcode_contracts/src packages/antcode_contracts/src/
# workspace 一致性：root pyproject.toml 声明 antcode_scrapy 为 workspace member
COPY packages/antcode_scrapy/pyproject.toml packages/antcode_scrapy/
COPY packages/antcode_scrapy/src packages/antcode_scrapy/src/

# workspace 一致性：uv sync 会校验 root pyproject.toml 里所有 members 目录存在
COPY services/web_api/pyproject.toml services/web_api/
COPY services/master/pyproject.toml services/master/
COPY services/worker/pyproject.toml services/worker/
# antcode_scrapy / services/gateway / services/worker 的 pyproject.toml 声明
# readme = "README.md"，hatchling 编 editable wheel 时缺 README.md 会直接挂
COPY packages/antcode_scrapy/README.md packages/antcode_scrapy/
COPY services/worker/README.md services/worker/

# 复制 gateway 服务
COPY services/gateway/pyproject.toml services/gateway/
COPY services/gateway/README.md services/gateway/
COPY services/gateway/src services/gateway/src/

# 创建虚拟环境并安装依赖
RUN uv venv /app/.venv && \
    . /app/.venv/bin/activate && \
    uv sync --package antcode-gateway && \
    # P1-21: 装 grpcio-health-checking(不在 pyproject.toml 里),让 server.py
    # 能注册 grpc.health.v1.Health 服务,healthcheck 走 grpc_health_probe 时
    # 才能真正拿到 SERVING/NOT_SERVING;否则 probe 会拿到 UNIMPLEMENTED。
    uv pip install "grpcio-health-checking>=1.60.0"

# ================== 阶段 2: 运行时镜像 ==================
FROM python:3.11.11-slim AS runtime
# buildx multi-arch 时用 TARGETARCH 拉对应架构的 grpc_health_probe，
# 否则 arm64 镜像里塞 amd64 二进制 → 运行时 exec format error
ARG TARGETARCH=amd64

WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}"

# 安装运行时依赖（curl + pgrep 用于 healthcheck；J5: grpc-health-probe 做 RPC 级探测）
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && GRPC_HEALTH_PROBE_VERSION=v0.4.24 \
    && curl -sSL "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-${TARGETARCH}" \
        -o /usr/local/bin/grpc_health_probe \
    && chmod +x /usr/local/bin/grpc_health_probe

# 创建非 root 用户（安全最佳实践）
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# 从构建阶段复制虚拟环境
COPY --from=builder /app/.venv /app/.venv

# 复制应用代码
COPY --chown=appuser:appgroup packages/antcode_core/src/antcode_core /app/packages/antcode_core/src/antcode_core
COPY --chown=appuser:appgroup packages/antcode_contracts/src/antcode_contracts /app/packages/antcode_contracts/src/antcode_contracts
COPY --chown=appuser:appgroup services/gateway/src/antcode_gateway /app/services/gateway/src/antcode_gateway

# 创建数据目录并设置权限
RUN mkdir -p \
    /app/data/backend/keys \
    /app/data/backend/work/executions \
    /app/data/backend/temp/source-bundles \
    /app/certs \
    && chown -R appuser:appgroup /app/data \
    && chown -R appuser:appgroup /app/certs \
    && chown -R appuser:appgroup /app/.venv \
    && chmod -R 755 /app/data

# 切换到非 root 用户
USER appuser

# 暴露 gRPC 端口
EXPOSE 50051

# P1-21: 健康检查只走 grpc_health_probe 的 RPC 级探测 —— 拿掉 pgrep 兜底,
# 因为 pgrep 只看进程名,server.start() 失败但主进程还没 exit 时会假 healthy。
# server.py 已经注册了 grpc.health.v1.Health 并在启动/关闭时置位 SERVING/NOT_SERVING,
# probe 会真实反映 gRPC 端口是否 listen + 服务是否可用。
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD /usr/local/bin/grpc_health_probe -addr=:50051 -connect-timeout=3s || exit 1

# 启动命令
CMD ["python", "-m", "antcode_gateway.main"]
