# =====================================================
# AntCode Worker 执行器服务 - Execution Plane
# =====================================================
# 任务执行、运行时管理（uv）、日志输出、心跳上报
# 支持 Direct 模式（内网直连 Redis）和 Gateway 模式（公网走 gRPC）
# =====================================================

# ================== 阶段 1: 构建阶段 ==================
FROM python:3.11.11-slim AS builder

WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖和 uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    git \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# 设置 uv 路径
ENV PATH="/root/.local/bin:${PATH}"

# 复制 workspace 配置
COPY pyproject.toml uv.lock ./

# 复制共享包
COPY packages/antcode_core/pyproject.toml packages/antcode_core/
COPY packages/antcode_core/src packages/antcode_core/src/
COPY packages/antcode_contracts/pyproject.toml packages/antcode_contracts/
COPY packages/antcode_contracts/src packages/antcode_contracts/src/
# workspace member：antcode_worker 依赖 antcode_scrapy；同时 uv sync 会
# 校验 root pyproject.toml 里所有 workspace members 目录都存在
COPY packages/antcode_scrapy/pyproject.toml packages/antcode_scrapy/
COPY packages/antcode_scrapy/src packages/antcode_scrapy/src/

# workspace 一致性：uv sync 会校验 root pyproject.toml 里所有 members 目录存在
COPY services/web_api/pyproject.toml services/web_api/
COPY services/master/pyproject.toml services/master/
COPY services/gateway/pyproject.toml services/gateway/
# antcode_scrapy / services/gateway / services/worker 的 pyproject.toml 声明
# readme = "README.md"，hatchling 编 editable wheel 时缺 README.md 会直接挂
COPY packages/antcode_scrapy/README.md packages/antcode_scrapy/
COPY services/gateway/README.md services/gateway/

# 复制 worker 服务
COPY services/worker/pyproject.toml services/worker/
COPY services/worker/README.md services/worker/
COPY services/worker/src services/worker/src/

# 创建虚拟环境并安装依赖
RUN uv venv /app/.venv && \
    . /app/.venv/bin/activate && \
    uv sync --package antcode-worker

# ================== 阶段 2: 运行时镜像 ==================
FROM python:3.11.11-slim AS runtime

WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}"

# 安装运行时依赖
# Worker 需要额外的系统工具来执行爬虫任务
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    wget \
    ca-certificates \
    # 用于 lxml
    libxml2 \
    libxslt1.1 \
    # 用于 curl_cffi
    libcurl4 \
    bubblewrap \
    # 进程管理
    procps \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（用于运行时管理 Python 环境）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# 创建非 root 用户（安全最佳实践）
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

# 从构建阶段复制虚拟环境
COPY --from=builder /app/.venv /app/.venv

# 安装 Playwright Chromium + 系统依赖（root 权限,先于 USER appuser 切换）
# --with-deps 会拉 apt-get 系统包(fonts / libs),arm64/amd64 均自适应
# rule.engine=playwright/render、js_click、infinite_scroll 任务必需
RUN . /app/.venv/bin/activate && \
    playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

# Playwright 默认把浏览器装到 /root/.cache/ms-playwright(root HOME),
# 但运行时是 appuser,需要复制或让 appuser 也能读到。这里直接把缓存搬到
# 全局位置并让 appuser 可读。
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN mkdir -p /opt/ms-playwright && \
    if [ -d /root/.cache/ms-playwright ]; then \
        cp -a /root/.cache/ms-playwright/. /opt/ms-playwright/ && \
        rm -rf /root/.cache/ms-playwright; \
    fi && \
    chown -R appuser:appgroup /opt/ms-playwright && \
    chmod -R a+rX /opt/ms-playwright

# 复制应用代码
COPY --chown=appuser:appgroup packages/antcode_core/src/antcode_core /app/packages/antcode_core/src/antcode_core
COPY --chown=appuser:appgroup packages/antcode_contracts/src/antcode_contracts /app/packages/antcode_contracts/src/antcode_contracts
COPY --chown=appuser:appgroup packages/antcode_scrapy/src/antcode_scrapy /app/packages/antcode_scrapy/src/antcode_scrapy
COPY --chown=appuser:appgroup services/worker/src/antcode_worker /app/services/worker/src/antcode_worker

# 创建数据目录并设置权限
RUN mkdir -p \
    /app/data/worker/runtimes \
    /app/data/worker/runs \
    /app/data/worker/secrets \
    /app/data/worker/identity \
    /app/data/worker/temp/runtime-build \
    /app/data/worker/temp/sandbox \
    && chown -R appuser:appgroup /app/data \
    && chown -R appuser:appgroup /app/.venv \
    && chmod -R 755 /app/data

# 为 appuser 安装 uv + mise（多语言 runtime 管理器；C4/M2：镜像内置避免
# 首次运行时 curl|sh 的 MITM 风险；同时容器化部署更希望镜像自包含）
USER appuser
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    curl -fsSL https://mise.run | sh
ENV PATH="/home/appuser/.local/bin:${PATH}"
# 镜像已预装 mise，禁止 worker 启动时再走 curl|sh
ENV ANTCODE_MISE_AUTO_INSTALL=false
ENV WORKER_SANDBOX_MODE=sandbox \
    WORKER_SANDBOX_COMMAND=bwrap \
    WORKER_SANDBOX_NETWORK_ISOLATED=true

# P1-21: 健康检查走 observability HTTP /health/ready (端口 8001,
# 由 antcode_worker.observability.server.ObservabilityServer 暴露)。
# 该 endpoint 会检查 transport 连接 + lifecycle ready 状态,pgrep 只看进程名
# 会让"传输层断开但进程还在"的场景被误判 healthy。
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD curl -fsS http://localhost:8001/health/ready >/dev/null || exit 1

# 启动命令：跳过交互式 menu，直接进 run 子命令。
# 具体 --transport / --name 由 compose environment 覆盖（走 WORKER_NAME / WORKER_TRANSPORT_MODE）
CMD ["python", "-m", "antcode_worker", "run"]
