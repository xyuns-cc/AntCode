# =====================================================
# AntCode Docker 环境变量配置示例
# =====================================================
# 复制此文件到 .env 并修改配置
# cp .env.example .env
#
# 重要：所有密码字段为必填，无默认值。
# =====================================================

# ================== 服务端口 ==================
WEB_API_PORT=8000
GATEWAY_GRPC_PORT=50051
FRONTEND_PORT=3000

# ================== PostgreSQL 配置（必填）==================
POSTGRES_DB=antcode
POSTGRES_USER=antcode
POSTGRES_PASSWORD=             # 必填：PostgreSQL 应用用户密码

# ================== 数据库连接池 ==================
# 默认 PG max_connections=200（compose 已配置）；多实例部署时调小
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_MAX_WEB_API=20
# DB_POOL_MAX_MASTER=15
# DB_POOL_MAX_GATEWAY=10
# DB_POOL_MAX_WORKER=5

# ================== Redis 配置（必填）==================
REDIS_PASSWORD=                # 必填：Redis 密码

# ================== Master 配置 ==================
MASTER_ID=master-1

# ================== Worker 配置 ==================
# 模式: direct (内网直连 Redis) 或 gateway (公网走 gRPC)
WORKER_TRANSPORT_MODE=direct
WORKER_NAME=worker-1

# ================== 安全配置（必填，缺失即启动失败）==================
# Fernet 加密 key：加密 git credentials / worker api_key / redis password 等
ENCRYPTION_KEY=                # 必填：任意随机字符串（>=32B），例：python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY_SALT=           # 非 Fernet 原生 key 必填：每部署唯一，例：openssl rand -hex 16
ENCRYPTION_LEGACY_KDF_SALT=    # 旧固定-salt PBKDF2 迁移窗口临时设 antcode-fernet-v1
ENCRYPTION_ALLOW_LEGACY_SHA256=false  # 仅旧密文迁移窗口临时开启

# JWT 签发 / 校验 key（inline 或 file 二选一）
JWT_SECRET=                    # 必填：任意随机字符串（>=32B）
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# ================== 日志配置 ==================
LOG_LEVEL=INFO
