# =====================================================
# AntCode Docker 环境变量配置示例
# =====================================================
# 复制此文件到 .env 并修改配置
# cp .env.example .env
#
# 此文件有两个作用：
#   1) compose 变量插值（端口 / postgres / redis 密码等 ${VAR} 引用）
#   2) 直接注入应用容器（compose env_file 注入链的第一环）
# 若项目根目录也存在 .env（本地开发同款配置），同名变量以【项目根 .env】为准。
# 只用 Docker 部署时，填完本文件的必填项即可，无需创建项目根 .env。
#
# 重要：所有标注"必填"的字段无默认值，缺失时对应服务启动失败。
# =====================================================

# ================== 服务端口 ==================
WEB_API_PORT=8000
GATEWAY_GRPC_PORT=50051
FRONTEND_PORT=3000

# ================== PostgreSQL 配置（必填）==================
POSTGRES_DB=antcode
POSTGRES_USER=antcode
POSTGRES_PASSWORD=             # 必填：PostgreSQL 应用用户密码

# ================== 数据库连接池 ==================
# 默认 PG max_connections=200（compose 已配置）；多实例部署时调小
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_MAX_WEB_API=20
# DB_POOL_MAX_MASTER=15
# DB_POOL_MAX_GATEWAY=10
# DB_POOL_MAX_WORKER=5

# ================== Redis 配置（必填）==================
REDIS_PASSWORD=                # 必填：Redis 密码
REDIS_NAMESPACE=antcode        # 必填：部署后不可随意变更

# ================== Master 配置 ==================
# 预留的实例标识：compose 会注入 master 容器，但当前代码尚未读取该变量
MASTER_ID=master-1

# ================== Worker 配置 ==================
# dev compose 中 worker 服务固定 direct，仅用于可信单租户开发/测试，禁止作为生产配置；
# compose environment 显式覆盖，改这里不影响 worker 容器；
# 此值会经 env_file 注入 web_api/master，作为控制面的默认 Worker 接入模式
WORKER_TRANSPORT_MODE=direct
WORKER_NAME=worker-1
# Worker 安装 Key：登录 Web 界面生成安装 Key 后填入并重启 worker，完成自动注册。
# 留空时 worker 容器会因缺少身份反复重启（restart: unless-stopped 持续重试），属预期现象。
ANTCODE_WORKER_KEY=

# ================== 默认管理员（首次启动创建）==================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=        # 必填（留空则不创建管理员，无法登录）：首次启动时创建 super_admin

# ================== 安全配置（必填，缺失即启动失败）==================
# Fernet 加密 key：加密 git credentials / worker api_key / redis password 等
ENCRYPTION_KEY=                # 必填：至少 32 字节（不足则拒绝启动），例：python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY_SALT=           # 非 Fernet 原生 key 必填：每部署唯一且至少 16 字节，例：openssl rand -hex 16
ENCRYPTION_LEGACY_KDF_SALT=    # 旧固定-salt PBKDF2 迁移窗口临时设 antcode-fernet-v1
ENCRYPTION_ALLOW_LEGACY_SHA256=false  # 仅旧密文迁移窗口临时开启
# 密钥轮换：逗号分隔的旧 ENCRYPTION_KEY，仅用于解密老密文，加密始终用当前 key。
# Worker primary-only 验证不覆盖其他 SecretBox 数据，不能单凭该验证清空全局 legacy。
# ENCRYPTION_KEYS_LEGACY=

# JWT 签发 / 校验 key。生产 Compose 强制从宿主机文件创建 Docker secret，
# 并只把它挂载到 migration / web-api 的 /run/secrets/jwt_secret。
# 文件内容至少 32 字节；不要把文件放进仓库，也不要在这里填写密钥内容。
ANTCODE_JWT_SECRET_FILE=/etc/antcode/secrets/jwt_secret

# 开发/自定义 Compose 的受信直接上游；留空时不信任转发头。生产 Compose
# 不读取此值，而是只信任 ANTCODE_FRONTEND_CONTROL_IP 的精确地址。
# 禁止使用 0.0.0.0/0、::/0 或不受本部署独占控制的共享网段。
ANTCODE_TRUSTED_PROXIES=

# ================== 日志配置 ==================
LOG_LEVEL=INFO

# ================== 非 K8s 生产镜像与入口 ==================
# 五个应用镜像（web-api / master / gateway / worker / frontend）由生产 Compose 的
# build 段在部署机上就地构建，不从任何 registry 拉取，因此只有 tag 没有 digest。
# ANTCODE_IMAGE_TAG 必须每次发布唯一（推荐用被部署的 40 位 Git commit），它是把
# "正在跑的容器"对回一次确定源码构建的唯一线索；复用同一个 tag 会让 `up -d`
# 认为镜像没变而不重建容器，等于发布没生效。
# 代价：本地构建没有不可变产物与签名，回滚必须 revert 源码后重新构建，
# 不能靠切回一个旧 digest（见 docs/release-runbook.md「构建与回滚」）。
# ANTCODE_IMAGE_TAG=
# 第三方运行时镜像不构建，仍按 digest pin：repository 与 digest 由 Compose 拼成
# repository@sha256:digest，digest 只填 64 位十六进制正文，不带 sha256: 前缀。
# 权威取值见 infra/docker/release-runtime-images.json。
# ANTCODE_POSTGRES_IMAGE_REPOSITORY=postgres:16-alpine
# ANTCODE_POSTGRES_IMAGE_DIGEST=
# ANTCODE_REDIS_IMAGE_REPOSITORY=redis:7.4-alpine
# ANTCODE_REDIS_IMAGE_DIGEST=
# ANTCODE_REVERSE_PROXY_IMAGE_REPOSITORY=nginxinc/nginx-unprivileged:1.27-alpine
# ANTCODE_REVERSE_PROXY_IMAGE_DIGEST=

# Core production credentials are host files mounted as Docker secrets. The
# files must be outside the repository; these variables contain paths only.
# ANTCODE_DATABASE_URL_FILE=/etc/antcode/secrets/database_url
# ANTCODE_REDIS_URL_FILE=/etc/antcode/secrets/redis_url
# ANTCODE_POSTGRES_PASSWORD_FILE=/etc/antcode/secrets/postgres_password
# ANTCODE_REDIS_HEALTHCHECK_PASSWORD_FILE=/etc/antcode/secrets/redis_healthcheck_password
# ANTCODE_ENCRYPTION_KEY_FILE=/etc/antcode/secrets/encryption_key
# ANTCODE_ENCRYPTION_KEY_SALT_FILE=/etc/antcode/secrets/encryption_key_salt
# ANTCODE_ENCRYPTION_KEYS_LEGACY_FILE=/etc/antcode/secrets/encryption_keys_legacy
# ANTCODE_JWT_SECRET_FILE=/etc/antcode/secrets/jwt_secret

# One-time bootstrap files are used only with their explicit override and are
# removed from the host immediately after bootstrap succeeds.
# ANTCODE_DEFAULT_ADMIN_PASSWORD_FILE=/etc/antcode/bootstrap/default_admin_password
# ANTCODE_WORKER_INSTALL_KEY_FILE=/etc/antcode/bootstrap/worker_install_key

# Gateway is published only for mTLS Workers. Restrict the bind address and
# host firewall to the dedicated Worker hosts.
# ANTCODE_GATEWAY_BIND_ADDRESS=192.0.2.10
# ANTCODE_GATEWAY_HOST=gateway.antcode.example
# ANTCODE_GATEWAY_PUBLIC_PORT=50051
# ANTCODE_PUBLIC_API_BASE_URL=https://antcode.example.com
# ANTCODE_WORKER_INSTALL_SOURCE_URL=https://github.com/OWNER/REPOSITORY.git
# ANTCODE_WORKER_INSTALL_SOURCE_REF=0123456789abcdef0123456789abcdef01234567
# ANTCODE_WORKER_INSTALL_UV_VERSION=0.8.17
# ANTCODE_TLS_CERTS_DIR=/etc/antcode/tls/public
# ANTCODE_GATEWAY_TLS_DIR=/etc/antcode/tls/gateway
# ANTCODE_REDIS_ACL_DIR=/etc/antcode/redis
# REDIS_HEALTHCHECK_USER=antcode-health

# Production proxy identity uses two dedicated, non-overlapping bridge
# networks and exact static proxy IPs. Choose unused RFC1918 ranges; each IP
# must belong to its declared subnet. Do not use a default-route CIDR.
#
# *_DYNAMIC_RANGE is mandatory, not optional: Docker's IPAM allocates from the
# low end of the subnet and does not know another container pinned an address,
# so the middleware started first would steal the address pinned to frontend
# and the deployment fails with "Address already in use". The dynamic range
# confines automatic allocation to a sub-block that excludes the pinned IPs.
# It must be a subnet of its declared subnet and must not contain the pinned IP.
#
# Size it for every container on the network, not just the long-lived ones:
# antcode-control carries postgres, redis, web-api, master, gateway plus the
# transient `compose run --rm` migration/crawl-redis-upgrade containers, so a
# /28 subnet (whose largest usable sub-block is a /29 = 6 addresses) is already
# too small. The values below are the layout the release E2E runs on.
# ANTCODE_CONTROL_SUBNET=172.30.40.0/26
# ANTCODE_CONTROL_DYNAMIC_RANGE=172.30.40.32/27
# ANTCODE_FRONTEND_CONTROL_IP=172.30.40.2
# ANTCODE_EDGE_SUBNET=172.30.40.64/26
# ANTCODE_EDGE_DYNAMIC_RANGE=172.30.40.96/27
# ANTCODE_REVERSE_PROXY_EDGE_IP=172.30.40.66

# Each Worker deployment must use a distinct project, name, container, volume,
# mTLS client certificate directory, and host/VM.
# ANTCODE_WORKER_NAME=worker-prod-01
# ANTCODE_WORKER_CONTAINER_NAME=antcode-worker-prod-01
# ANTCODE_WORKER_DATA_VOLUME=antcode-worker-prod-01-data
# ANTCODE_WORKER_TLS_DIR=/etc/antcode/tls/workers/worker-prod-01

# Resource/backup boundaries. Redis maxmemory must stay below mem_limit (4 GiB).
# ANTCODE_REDIS_MAXMEMORY=3gb
# BACKUP_RETENTION_DAYS=14
# BACKUP_TIMEOUT_SECONDS=3600
# BACKUP_MAX_AGE_SECONDS=90000
# BACKUP_HEALTH_START_PERIOD=2h

# 出站探测、Git 源码和批量管理资源边界
PROJECT_TEST_CONNECTION_TIMEOUT_SECONDS=5
PROJECT_TEST_CONNECTION_MAX_RESPONSE_BYTES=1048576
GIT_DNS_TIMEOUT_SECONDS=10
GIT_LS_REMOTE_TIMEOUT_SECONDS=30
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_MAX_COMMAND_OUTPUT_BYTES=8388608
GIT_MAX_TRANSFER_BYTES=536870912
GIT_MAX_REPOSITORY_BYTES=536870912
GIT_MAX_BLOB_BYTES=67108864
GIT_MAX_OBJECTS=200000
GIT_MAX_REFS=20000
GIT_SCAN_MAX_FILES=100000
GIT_SCAN_MAX_DIRECTORIES=20000
GIT_SCAN_MAX_DEPTH=50
GIT_SCAN_MAX_CANDIDATES=10000
API_MANAGEMENT_BATCH_MAX_ITEMS=100

# Worker 只从允许的 HTTPS registry 安装 Node lockfile 依赖；lifecycle scripts 始终禁用
NODE_PACKAGE_REGISTRY_ALLOWLIST=https://registry.npmjs.org
NODE_LOCKFILE_MAX_BYTES=8388608
NODE_INSTALL_MAX_OUTPUT_BYTES=2097152
